DATABASE_URL="postgresql://meucardapio:meucardapio@localhost:55432/meucardapio?schema=public"
# SEGREDOS (obrigatórios fora de NODE_ENV=test; a API recusa subir sem eles ou com valor curto/de exemplo).
# Gere com `pnpm --filter @meucardapio/api gen:secrets` (só imprime; copie para o seu .env local).
# Mínimo 32 caracteres aleatórios. JWT_SECRET e MFA_HMAC_KEY devem ser DIFERENTES.
JWT_SECRET=""
MFA_HMAC_KEY=""
PORT=3001
WEB_ORIGIN="http://localhost:3000"
# Access token da conta Mercado Pago (Test ou Production) — https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=""
# Chave secreta do webhook (painel Mercado Pago -> Webhooks -> assinatura secreta). Sem isso,
# o endpoint /api/payments/webhook rejeita toda notificação (ver lib/mercadopago.ts).
MP_WEBHOOK_SECRET=""
# E-mail transacional (recuperação de senha) via Resend — https://resend.com/api-keys
# Sem a chave, o link de reset só vai pro log do servidor (modo dev).
RESEND_API_KEY=""
# Remetente — precisa ser de um domínio verificado no Resend em produção; em dev pode deixar
# "onboarding@resend.dev" (só envia pro e-mail da sua própria conta Resend).
EMAIL_FROM="MeuCardapio <onboarding@resend.dev>"
# Dias de teste grátis de lojas novas (padrão 14).
TRIAL_DAYS=14
# Confirmação de segurança por e-mail (código de 6 dígitos) em estorno, troca de senha e remoção
# de usuário. Com "true", essas ações exigem o header x-mfa-challenge; desligado por padrão.
MFA_ENFORCED="false"
# Back-office (API-25): o x-admin-token foi APOSENTADO. A equipe entra por /api/platform/auth/login (senha + código por e-mail).
# Contas da equipe: `apps/api/scripts/create-platform-admin.ts` (veja o cabeçalho do arquivo) (e-mail e senha por variável de ambiente, nunca por argumento).
# Duração da sessão da equipe, em horas (padrão 8).
PLATFORM_SESSION_HOURS=8
# Créditos de IA: máximo por operação (padrão 100) e patamar de "concessão grande" (padrão 50).
CREDIT_GRANT_MAX=100
CREDIT_GRANT_ALERT_AT=50
# E-mail do responsável da plataforma que recebe aviso de toda concessão/ajuste de créditos (opcional).
PLATFORM_ALERT_EMAIL=""

# Sessão do painel (ADR-0008): janela deslizante e teto absoluto desde o login.
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_DAYS=14
# Cookie de sessão Secure por padrão. Só "false" em dev local sem https (Safari/IP de rede local).
COOKIE_SECURE="true"
# IPs/CIDRs do proxy reverso (Caddy) em que se confia para ler X-Forwarded-For; separados por
# vírgula. Vazio = ignora o cabeçalho (rate limit usa o IP do socket). Ex.: "172.18.0.0/16"
TRUST_PROXY_CIDR=""

# API-18 / INF-10: storage de imagens (S3-compativel). Sem STORAGE_S3_ENDPOINT usa o Fake em memoria (nada persiste).
# Dev com S3Mock (docker compose -f infra/docker-compose.dev.yml up -d s3mock). Configure MEDIA_INTERNAL_URL também no web.
# STORAGE_S3_ENDPOINT=http://127.0.0.1:59000
# STORAGE_S3_BUCKET=cardapio-media
# STORAGE_S3_ACCESS_KEY_ID=dev-key
# STORAGE_S3_SECRET_ACCESS_KEY=dev-secret
# STORAGE_PUBLIC_BASE_URL=/media
# MEDIA_MAX_IMAGES_PER_STORE=500
# PIX por loja (API-07, ADR-0001): tokens do Mercado Pago de cada loja ficam CIFRADOS (AES-256-GCM) no banco.
# PAYMENT_ENC_KEY: chave PRÓPRIA (mín. 32 caracteres aleatórios; diferente de JWT_SECRET/MFA_HMAC_KEY). Fora do banco.
# Perdê-la obriga todas as lojas a reconectar o Mercado Pago. Rotação: ponha a nova em PAYMENT_ENC_KEY (+ PAYMENT_ENC_KEY_ID=v2)
# e a antiga em PAYMENT_ENC_KEY_PREV (+ PAYMENT_ENC_KEY_PREV_ID=v1) até todos os registros serem regravados.
PAYMENT_ENC_KEY=""
PAYMENT_ENC_KEY_ID="v1"
# MP_OAUTH_MODE: "fake" (padrão em dev; NUNCA sobe em produção) ou "real" (exige MP_CLIENT_ID e MP_CLIENT_SECRET do aplicativo
# do Mercado Pago, pendentes: CL-13). PUBLIC_API_URL: endereço público da API; o callback é <PUBLIC_API_URL>/api/store/payments/mercadopago/callback
# e precisa estar cadastrado igual no aplicativo do Mercado Pago.
MP_OAUTH_MODE="fake"
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
PUBLIC_API_URL=""

# NODE_ENV ausente conta como PRODUÇÃO nas travas de segurança (fake do PIX, TRUST_PROXY_CIDR). O `pnpm dev` já define
# NODE_ENV=development; se você sobe a API de outro jeito, defina-o aqui. Em produção o compose define NODE_ENV=production
# e o PIX por loja exige MP_OAUTH_MODE=off ou real.
NODE_ENV="development"
# Revalidação sob demanda da vitrine (API-58, ADR-0013 §2.4). A API chama o web PELA REDE INTERNA quando preço,
# visibilidade, esgotado ou horário mudam, para a página refletir em ≤ 5 s. Sem as DUAS variáveis fica desligada
# (o ISR de 30 s continua valendo). O segredo é o mesmo nos dois lados (REVALIDATE_SECRET no web) e nunca vai ao navegador.
WEB_INTERNAL_URL=""
REVALIDATE_SECRET=""

# API-18 (decisao do Claudio, 18/11): em PRODUCAO as imagens ficam em DISCO LOCAL do servidor, servidas pelo Caddy (sem S3/R2).
# STORAGE_DRIVER=local | s3 (padrao s3; sem endpoint S3 em dev/teste cai no Fake em memoria)
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=/data/uploads            # caminho ABSOLUTO; volume persistente (entra no backup)
# STORAGE_PUBLIC_BASE_URL=https://seu-dominio/media   # rota de leitura no proxy; https fora de dev
