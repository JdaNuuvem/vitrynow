generator client {
  provider      = "prisma-client-js"
  // "native" cobre o Windows/dev local; "linux-musl-openssl-3.0.x" é o motor certo pra
  // imagem node:20-alpine em produção (Alpine 3.18+ vem com OpenSSL 3, não 1.1 — sem isso
  // o container derruba com "Error loading shared library libssl.so.1.1").
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// API-16 (B9): o que fazer com bairro fora da lista (só vale quando a loja tem bairros cadastrados).
enum DeliveryOutsideMode {
  REFUSE
  DEFAULT_FEE
}

// API-16 (B9): bairro atendido, com taxa e prazo. Único por loja (nameKey = nome sem acento/caixa).
model DeliveryZone {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name          String
  nameKey       String
  feeCents      Int
  etaMinMinutes Int?
  etaMaxMinutes Int?
  freeFromCents Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([id, storeId])
  @@unique([storeId, nameKey])
  @@index([storeId])
}

enum UserRole {
  OWNER
  STAFF
}

enum OrderType {
  MESA
  DELIVERY
  BALCAO
}

enum OrderStatus {
  PENDENTE
  CONFIRMADO
  EM_PREPARO
  PRONTO
  SAIU_PARA_ENTREGA // só DELIVERY (ADR-0007)
  CONCLUIDO
  CANCELADO
}

enum CashMovementType {
  SUPRIMENTO // reforço de caixa (entrada de dinheiro fora de venda)
  SANGRIA // retirada de dinheiro do caixa
  DEVOLUCAO // devolução ao cliente de pedido em dinheiro de caixa já fechado (só o sistema cria; RN-CX-14)
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum PaymentStatus {
  PENDENTE
  APROVADO
  REJEITADO
  EXPIRADO
  REEMBOLSADO
  EM_ANALISE // MP in_process/authorized
  CANCELADO // cobrança cancelada por nós
  ESTORNO_PENDENTE // estorno pedido, ainda não confirmado
  CONTESTADO // MP charged_back
}

enum HistorySource {
  PANEL
  CUSTOMER
  SYSTEM
  WEBHOOK
}

enum OrderSource {
  CLIENTE
  PAINEL
  QR_MESA // API-22: pedido feito pelo celular do cliente no QR da mesa
}

enum HistoryKind {
  ADVANCE
  UNDO
  CANCEL
  SYSTEM
}

enum OrderPaymentMethod {
  DINHEIRO
  PIX
  CREDITO
  DEBITO
  VR
  VA
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELED
}

model Store {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  code         String   @unique
  timezone     String   @default("America/Sao_Paulo")
  logoUrl      String?
  coverImageUrl String? // banner exibido no topo do cardápio público, separado da logo
  primaryColor String? // ex. "#16a34a" — aplicado no storefront público
  customDomain String? @unique // nome de host em minúsculas (validado em shared-types); ÚNICO: duas lojas nunca reivindicam o mesmo domínio (SEC-14/ST-18)
  address       String? // exibido no cardápio público
  whatsapp      String? // só dígitos com DDI, ex. "5521999999999" — vira link wa.me
  openingHours  String? // texto livre, ex. "Seg a sáb, 09:00 às 17:00" (só informativo; a grade fica em `schedule`)
  schedule      Json?   // B5/API-11: grade semanal + exceções + corte (modules/storeHours); null = sem grade (loja aberta quando ligada)
  pausedUntil   DateTime? // "Pausar 15/30/60 min": recusa pedido até este instante
  closedUntil   DateTime? // "Fechar por hoje": recusa pedido até a próxima abertura da grade
  busyUntil     DateTime? // g1 "Estou lotado": recusa pedido novo até este instante (relógio do servidor; sem job)
  busyStartedAt DateTime? // g1 (Deming P2): início do ocupado CONTÍNUO; teto de 240 min conta daqui, religar não zera
  busyExtraMinutes Int? // g1 (RN-OCU-05): minutos somados ao prazo mostrado enquanto durar o modo ocupado (10, 20 ou 30)
  prepMinutesDelivery Int? // tempo médio de preparo (5..240) para a previsão ao cliente; null = sem previsão (API-57)
  prepMinutesPickup   Int?
  minOrderCents Int?    // pedido mínimo do storefront público; null = sem mínimo
  deliveryEnabled Boolean @default(true)
  pickupEnabled   Boolean @default(true)
  acceptingOrders Boolean @default(true) // interruptor "Disponível" do painel: false = cardápio público recusa pedidos
  hideSoldOutProducts Boolean @default(false) // API-17 (RN-B11-03): esconde produtos esgotados no cardápio público
  deliveryZones   DeliveryZone[]
  deliveryOutsideMode   DeliveryOutsideMode @default(REFUSE) // API-16: bairro fora da lista (só com bairros cadastrados)
  freeShippingFromCents Int?                                 // API-16: frete grátis geral a partir do subtotal líquido
  deliveryFeeCents Int    @default(0) // taxa de entrega fixa somada a pedidos DELIVERY
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  importBatches ImportBatch[]
  deviceTokens DeviceToken[]
  categories   Category[]
  products     Product[]
  orders       Order[]
  cashSessions CashSession[]
  coupons      Coupon[]
  deliverers   Deliverer[]
  auditLogs    AuditLog[]
  deviceAlerts DeviceAlert[]
  feedbacks    Feedback[]
  doNotContact DoNotContact[]
  subscription Subscription?
  menuCampaign MenuCampaign?
  paymentAccounts PaymentAccount[]
  optionGroups OptionGroup[]
  counter      StoreCounter?
  printJobs    PrintJob[]
  onboardingSteps OnboardingStep[]
  activationEvents ActivationEvent[]
  images       Image[]
  printMode    PrintMode @default(LEGACY) // modo de impressão decidido pelo SERVIDOR por loja (ADR-0004 §8.12)
  manualDiscountStaffLimitPercent Int @default(10) // desconto manual do pedido lançado no painel: STAFF até este %, acima só o OWNER (RN-B2-06)
  cashStaffWithdrawalLimitCents Int @default(0) // limite de sangria do STAFF por lançamento (RN-CX-09); 0 = toda sangria exige o dono
  featureInterests FeatureInterest[]
  // API-22 (mesa/QR, ADR-0002): aceita pedido pelo QR; por padrão a equipe precisa aceitar (RN-MB-01).
  qrOrderingEnabled    Boolean @default(true)
  qrOrdersNeedApproval Boolean @default(true)
  // Taxa de serviço sugerida no fechamento da mesa (0 a 30 %; 0 = a loja não cobra). Opcional em cada recebimento. Todos os planos.
  serviceFeePercent    Int     @default(10)
  ingredients          Ingredient[]
  stockMovements       StockMovement[]
  tables               Table[]
  receipts             Receipt[]
  // API-25: suspensão MANUAL pela equipe da plataforma (back-office). Nulo = não suspensa. Independe da suspensão por assinatura (API-09).
  platformSuspendedAt     DateTime?
  platformSuspendedReason String?
  aiCreditLedger AiCreditLedger[]
  dish3dJobs     Dish3dJob[]
  floorElements  FloorElement[]
  reservations   Reservation[]
}

enum TableShape {
  SQUARE
  ROUND
  RECT
}

enum FloorElementKind {
  WALL
  COUNTER
  PLANT
  DOOR
}

// SALÃO 3D: elementos fixos do salão (parede, balcão, planta, porta). A disposição é dado da loja, nunca código.
model FloorElement {
  id       String           @id @default(cuid())
  storeId  String
  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind     FloorElementKind
  posX     Float
  posZ     Float
  width    Float            @default(1)
  depth    Float            @default(0.15)
  rotation Int              @default(0)
  area     String?

  @@index([storeId])
}

enum ReservationStatus {
  BOOKED   // reservada
  SEATED   // cliente chegou e sentou
  CANCELED
  NO_SHOW  // não apareceu
}

// SALÃO 3D (opcional): reserva de mesa. Dado pessoal mínimo (nome e telefone opcional), só no painel.
model Reservation {
  id              String            @id @default(cuid())
  storeId         String
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tableId         String?
  table           Table?            @relation(fields: [tableId, storeId], references: [id, storeId], onDelete: NoAction)
  customerName    String
  customerPhone   String?
  partySize       Int
  startsAt        DateTime
  durationMin     Int               @default(90)
  status          ReservationStatus @default(BOOKED)
  notes           String?
  createdByUserId String
  createdAt       DateTime          @default(now())

  @@index([storeId, startsAt])
  @@index([tableId, startsAt])
}

// API-22 (ADR-0002 nível 1): mesa física com QR próprio. `qrToken` é opaco (256 bits), nunca derivado de id/slug, e regenerável.
model Table {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label     String
  qrToken   String   @unique
  active    Boolean  @default(true)
  position  Int      @default(0)
  // SALÃO 3D: planta (metros no plano do piso; rotação em graus), formato, lugares e setor.
  posX      Float      @default(0)
  posZ      Float      @default(0)
  rotation  Int        @default(0)
  shape     TableShape @default(SQUARE)
  seats     Int        @default(4)
  area      String?
  // Avisos do QR guardados até a equipe marcar como atendido (ou a mesa ser recebida).
  callWaiterAt DateTime?
  askBillAt    DateTime?
  // SALÃO 3D (opcionais): garçom responsável (usuário da loja) e pessoas sentadas agora (zera ao receber a mesa).
  waiterUserId String?
  waiter       User?    @relation("TableWaiter", fields: [waiterUserId], references: [id], onDelete: SetNull)
  guests       Int?
  reservations Reservation[]
  createdAt DateTime @default(now())
  orders    Order[]
  receipts  Receipt[]

  @@unique([storeId, label])
  @@unique([id, storeId]) // alvo da FK composta de Order: o banco recusa mesa de outra loja
}

// Contador atômico por loja (hoje: sequência do código do pedido). Incrementado com
// INSERT ... ON CONFLICT DO UPDATE ... RETURNING dentro da transação do pedido (B01).
model StoreCounter {
  storeId  String @id
  store    Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderSeq Int    @default(0)
}

model User {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  role         UserRole @default(OWNER)
  // Versão da sessão (ADR-0008): incrementa em troca/redefinição de senha, mudança de papel e
  // "sair de todos os dispositivos". JWT com `tv` diferente é recusado (SESSION_REVOKED).
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  noticeDismissals UserNoticeDismissal[]
  emailVerifiedAt DateTime? // API-26: e-mail confirmado (RN-ONB-03); nulo = ainda não verificado
  emailVerificationTokens EmailVerificationToken[]
  waiterTables Table[] @relation("TableWaiter")

  @@index([storeId])
}

// Avisos de mudança de regra que o usuário já dispensou (RN-MIG-04b): uma linha por (usuário, aviso); dispensar de novo não muda nada.
model UserNoticeDismissal {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noticeId    String
  dismissedAt DateTime @default(now())

  @@id([userId, noticeId])
}

// Token de recuperação de senha. Entrega por e-mail via Resend (lib/email.ts) — sem
// RESEND_API_KEY configurado, cai no modo dev e o link vai pro log do servidor.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // NG-06: hash SHA-256 do token enviado por e-mail (o valor em si nunca é gravado).
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  // SEC-29 (ST-67): e-mails de confirmação que NÃO bateram com a conta deste token; na 5ª falha o token é invalidado.
  emailFailures Int   @default(0)
  // SEC-28b (ST-65): o envio do e-mail falhou (provedor fora, sem chave, erro); a tentativa não conta nos 3 pedidos por hora.
  sendFailedAt DateTime?

  @@index([userId])
}

// Token do módulo de impressão local (print-client). Não é login humano:
// é gerado no painel ("chave de impressora") e usado só pela loja/dispositivo.
model DeviceToken {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // NG-06: só o hash SHA-256 do token vai para o banco; o valor aparece UMA vez, ao criar.
  tokenHash    String    @unique
  tokenPreview String // últimos 4 caracteres, só para o dono reconhecer a chave na lista
  label      String? // ex.: "PC do balcão"
  revokedAt  DateTime?
  lastSeenAt DateTime? // atualizado a cada chamada autenticada (heartbeat) — ver plugins/auth.ts
  createdAt  DateTime  @default(now())

  @@index([storeId])
}

model Category {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  icon      String?   // emoji exibido antes do nome no cardápio público (chip de categoria)
  position  Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())

  @@index([storeId])
  @@unique([id, storeId]) // API-48: alvo das FKs compostas por loja (ADR-0009)
}

model Product {
  id          String       @id @default(cuid())
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?    @relation(fields: [categoryId, storeId], references: [id, storeId], onDelete: NoAction) // API-48: o banco recusa categoria de outra loja
  name        String
  description String?
  imageUrl    String?
  priceCents  Int
  active      Boolean      @default(true)
  featured    Boolean      @default(false)
  position    Int          @default(0)
  soldOut      Boolean     @default(false) // API-17 (B11): esgotado; vale até soldOutUntil (null = até reativar)
  soldOutUntil DateTime?
  // Produto detalhado (PD, carimbo 790000): tudo opcional/com padrao neutro; produto antigo segue identico. Dinheiro em centavos, peso em gramas inteiras.
  promoCents   Int?      // preco promocional (< priceCents); vale entre promoStartsAt e promoEndsAt pelo relogio do SERVIDOR
  promoStartsAt DateTime? // instante UTC (00:00 do dia escolhido no fuso da loja)
  promoEndsAt   DateTime? // instante UTC EXCLUSIVO (00:00 do dia seguinte ao dia final escolhido)
  kind         ProductKind @default(PRATO)
  sellAlone    Boolean   @default(true) // false = adicional que nao vende sozinho
  saleUnit     SaleUnit  @default(UN)   // KG/HG: priceCents e o preco do QUILO (HG so muda como a tela digita e mostra)
  minGrams     Int       @default(100)
  stepGrams    Int       @default(50)
  maxGrams     Int       @default(5000)
  isSingleDish Boolean   @default(false)
  // Produto detalhado, extras (PD-800000): codigo interno do dono (NUNCA publico) e selos do cardapio. Alergenos ficam FORA (decisao do Claudio; o juridico define a lista).
  sku          String?
  tags         ProductTag[] @default([])
  portionGrams Int?
  serves       Int?
  additionals ProductAdditional[]
  optionGroups ProductOptionGroup[]
  addonOptions Option[] @relation("AddonOptions")
  recipeItems  RecipeItem[] // ESTOQUE: ficha técnica
  // PRATO 3D: modelo GLB gerado (rascunho até o dono publicar; o cardápio só mostra com model3dPublished)
  model3dUrl       String?
  model3dPublished Boolean @default(false)
  dish3dJobs       Dish3dJob[]
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())

  @@unique([id, storeId]) // ADR-0009: base das FKs compostas por loja (ProductOptionGroup)
  @@unique([storeId, sku]) // SKU unico na loja; varios produtos sem SKU (NULL) convivem
  @@index([storeId])
  @@index([categoryId])
}

model ProductAdditional {
  id         String  @id @default(cuid())
  productId  String
  storeId    String // API-48b
  product    Product @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  name       String
  priceCents Int

  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  // NG-16: SHA-256 do token de acesso do cliente (cardápio público). O token em si só existe na resposta da criação.
  publicTokenHash String? @unique
  // API-21 (RN-CX-01/02): quando o dinheiro deste pedido foi RECEBIDO. O caixa conta dinheiro só a partir daqui; null = ainda não recebido.
  paidAt        DateTime?
  cashRefundMovementId String? @unique // API-59 (RN-CX-14): DEVOLUCAO criada no caixa ATUAL ao cancelar pedido de caixa ja fechado; unico = idempotencia
  paidAtApproximate Boolean @default(false) // true = `paidAt` estimado pela migração (sem o instante real); novos pedidos gravam o real
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String // sequencial legível por loja, ex. "0007"
  type          OrderType
  status        OrderStatus @default(PENDENTE)
  customerName  String?
  customerPhone String?
  address       String?
  notes         String?
  subtotalCents Int         @default(0)
  discountCents Int         @default(0)
  totalCents    Int         @default(0)
  couponId      String?
  coupon        Coupon?     @relation(fields: [couponId, storeId], references: [id, storeId], onDelete: NoAction) // API-48: composta; apagar o cupom zera `couponId` no serviço (a FK composta nao pode anular `storeId`)
  delivererId   String?
  deliverer     Deliverer?  @relation(fields: [delivererId, storeId], references: [id, storeId], onDelete: NoAction) // API-48: idem cupom
  paymentMethod  OrderPaymentMethod? // null = forma de pagamento não identificada
  changeForCents Int? // "troco para" informado pelo cliente (só DINHEIRO)
  deliveryFeeCents Int      @default(0) // snapshot da taxa de entrega — já incluída em totalCents
  deliveryZoneName String?  // API-16: cópia do nome/prazo do bairro na hora do pedido (RN-B9-04)
  deliveryEtaMinMinutes Int?
  deliveryEtaMaxMinutes Int?
  tipCents       Int        @default(0) // gorjeta — já incluída em totalCents
  awaitingPayment Boolean   @default(false) // true enquanto espera confirmação de pagamento online (ex. PIX) — não entra no kanban/impressão até confirmar
  // API-40 (PRO): pedido agendado. `held` = retido até o job `schedule.release` soltar (scheduledFor - tempo de preparo); fora do kanban/impressão até lá.
  scheduledFor    DateTime?
  held            Boolean   @default(false)
  // ESTOQUE: baixa feita ao aceitar (custo das mercadorias do pedido, CMV) e estorno se cancelado depois. Idempotência pelos instantes.
  cogsCents        Int?
  stockDeductedAt  DateTime?
  stockReversedAt  DateTime?
  printedAt     DateTime?
  canceledAt        DateTime?
  couponReleasedAt  DateTime? // idempotência da devolução do cupom (ADR-0007)
  refundLockedAt    DateTime? // estorno em curso: congela o pedido NA PRÓPRIA linha (ver ADR-0007 §11); nula = livre
  anonymizedAt      DateTime? // LGPD (API-52, ADR-0014): quando o dado pessoal do cliente foi removido (nome, telefone, endereço, observações); valores, itens e datas ficam
  internalNote      String? // observação interna da loja (API-54): nunca vai ao cliente, ao tíquete nem a lista; só ao detalhe do painel
  // API-13 (pedido manual, RN-B2-09/10): quem lançou e por onde; a chave de idempotência da abertura do formulário (única por loja)
  source            OrderSource @default(CLIENTE)
  channel           String?
  createdByUserId   String?
  manualKey         String?
  manualBodyHash    String? // impressão digital do corpo que usou a chave: mesma chave + corpo diferente = 409 (RN-B2-10)
  manualDiscountPercent Int?
  manualDiscountReason  String?
  // API-22 (mesa): mesa do pedido e SHA-256 do token anônimo do aparelho que o fez ("Minha mesa" mostra só os pedidos do próprio aparelho, RN-MB-06).
  tableId           String?
  table             Table?      @relation(fields: [tableId, storeId], references: [id, storeId])
  // API-24 (ADR-0012): recebimento que pagou este pedido de mesa. Pedido de mesa só vira venda/caixa no `receivedAt` do Receipt (RN-MB-04).
  receiptId         String?
  receipt           Receipt?    @relation(fields: [receiptId, storeId], references: [id, storeId], onDelete: NoAction) // API-48
  deviceTokenHash   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items           OrderItem[]
  statusHistory    OrderStatusHistory[]
  payment          Payment?
  printJobs        PrintJob[]

  @@unique([storeId, code])
  @@unique([storeId, manualKey])
  @@unique([id, storeId]) // alvo da FK composta de PrintJob (ADR-0009: o banco recusa referência entre lojas)
  @@index([storeId, status])
  @@index([storeId, createdAt]) // histórico e kanban por período (API-54)
  @@index([storeId, tableId, status])
  @@index([storeId, deviceTokenHash])
  @@index([held, scheduledFor]) // API-40: o job schedule.release varre só os retidos
  @@index([receiptId]) // API-24: o CREATE INDEX da migracao 500000 tem que existir no schema (drift 0)
  @@index([couponId])
  @@index([delivererId])
}

enum ProductKind {
  PRATO
  ADICIONAL
}

enum ProductTag {
  VEGANO
  VEGETARIANO
  SEM_GLUTEN
  SEM_LACTOSE
  PICANTE
  FIT
}

enum SaleUnit {
  UN
  KG
  HG
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  storeId      String // API-48b
  order        Order    @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String   @default("") // snapshot do nome no momento do pedido — sobrevive a produto renomeado/excluído
  quantity     Int
  unitPriceCents Int
  notes        String?
  // Produto detalhado: copias do momento do pedido. `listPriceCents` = preco normal da unidade (so quando havia promocao); venda por peso: quantity=1, `unitPriceCents` = valor da linha.
  listPriceCents Int?
  weightGrams    Int?
  pricePerKgCents Int?
  cogsCents       Int? // ESTOQUE: custo da linha (ficha técnica × custo médio) gravado na baixa; base da margem real por prato

  additionals  OrderItemAdditional[]
  options      OrderItemOption[]

  @@unique([id, storeId]) // API-48b: alvo das FKs compostas de adicionais e opções
  @@index([orderId])
}

// Snapshot do adicional escolhido (nome/preço no momento do pedido — não aponta mais para
// ProductAdditional porque o cardápio pode mudar depois sem afetar pedidos já feitos).
// ESTOQUE: `additionalId` (sem FK) = id do adicional, que é o mesmo da opção-espelho LEGACY; a ficha técnica dela dá baixa.
model OrderItemAdditional {
  id          String    @id @default(cuid())
  orderItemId String
  storeId     String // API-48b
  orderItem   OrderItem @relation(fields: [orderItemId, storeId], references: [id, storeId], onDelete: Cascade)
  name        String
  priceCents  Int
  additionalId String?

  @@index([orderItemId])
}

// ---- API-07 (ADR-0001): PIX por loja via OAuth do Mercado Pago. Tokens SEMPRE cifrados (lib/paymentCrypto.ts). ----

enum PaymentAccountStatus {
  CONNECTED
  NEEDS_RECONNECT // renovação falhou ou o provedor revogou: o PIX some do checkout e o dono é avisado
  DISCONNECTED // histórico: SEM tokens. Pagamentos pendentes/em estorno impedem desconectar ou trocar de vendedor; os já ENCERRADOS ficam presos a esta conta, então um estorno tardio deles só sai pelo app do próprio Mercado Pago
}

// Uma conta ativa (CONNECTED/NEEDS_RECONNECT) por loja e um vendedor do provedor em uma só loja: índices únicos PARCIAIS
// na migração (o Prisma não os expressa). A conta anterior vira DISCONNECTED e fica no histórico (D1-2).
model PaymentAccount {
  id              String               @id @default(cuid())
  storeId         String
  store           Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider        String               @default("mercadopago")
  sellerUserId    String // id do vendedor no provedor (nunca vai a resposta, log ou auditoria sem máscara)
  status          PaymentAccountStatus @default(CONNECTED)
  accessTokenEnc  String? // `v1.<keyId>.<iv>.<tag>.<ct>`; null depois de desconectar (apagado, não só marcado)
  refreshTokenEnc String?
  expiresAt       DateTime? // fim do access_token
  connectedAt     DateTime             @default(now())
  disconnectedAt  DateTime?
  lastRefreshAt   DateTime?
  lastRefreshAttemptAt DateTime? // última tentativa (certa ou errada): o job conta no máximo uma falha por dia
  refreshFailures Int                  @default(0)
  lastError       String? // texto curto, sem dado sensível
  payments        Payment[]

  @@unique([id, storeId])
  @@index([storeId, status])
  @@index([status, expiresAt])
}

// `state` do OAuth: só o HASH fica no banco, uso único, expira em minutos, preso à loja, ao usuário e à sessão (D1-1).
model PaymentOAuthState {
  id        String    @id @default(cuid())
  storeId   String
  userId    String
  sid       String // sessão que iniciou a conexão
  stateHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// ---- B8: grupos de opções e variações (API-15, ADR-0009: FKs compostas por loja) ----

enum OptionPriceMode {
  SUM  // o preço da opção se SOMA ao do produto (Borda +R$ 8); é o comportamento dos adicionais
  BASE // o preço da opção É o preço do produto (Pizza P/M/G); no máximo um grupo BASE por produto, sempre 1..1
}

// Grupo de opções da loja, reutilizável em vários produtos ("Tamanho", "Borda", "Molhos").
model OptionGroup {
  id           String          @id @default(cuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  helpText     String?
  minSelect    Int             @default(0) // 0 = opcional; >= 1 = obrigatório
  maxSelect    Int? // null = sem limite (adicionais legados)
  maxPerOption Int             @default(1) // quantidade máxima de cada opção ("até 2 bacons")
  priceMode    OptionPriceMode @default(SUM)
  source       String          @default("MANUAL") // "LEGACY_ADDITIONALS" = espelho de ProductAdditional (fase expand)
  createdAt    DateTime        @default(now())

  options  Option[]
  products ProductOptionGroup[]

  @@unique([id, storeId])
  @@index([storeId])
}

model Option {
  id         String      @id @default(cuid())
  storeId    String
  groupId    String
  group      OptionGroup @relation(fields: [groupId, storeId], references: [id, storeId], onDelete: Cascade)
  name       String
  priceCents Int
  active     Boolean     @default(true) // false = indisponível (some da escolha, RN-B8-05)
  position   Int         @default(0)
  createdAt  DateTime    @default(now())
  // RN-PD-12: opção que aponta para um produto ADICIONAL da MESMA loja (FK composta). INHERIT = nome e preço vêm do adicional; OWN = preço próprio só aqui.
  productId   String?
  priceSource OptionPriceSource @default(OWN)
  product     Product?          @relation("AddonOptions", fields: [productId, storeId], references: [id, storeId], onDelete: NoAction)
  recipeItems OptionRecipeItem[]

  @@unique([id, storeId])
  @@index([groupId])
  @@index([productId])
}

enum OptionPriceSource {
  OWN
  INHERIT
}

// Vínculo produto ↔ grupo, com a ordem em que o cliente vê os grupos.
model ProductOptionGroup {
  productId String
  groupId   String
  storeId   String
  product   Product     @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  group     OptionGroup @relation(fields: [groupId, storeId], references: [id, storeId], onDelete: Cascade)
  position  Int         @default(0)

  @@id([productId, groupId])
  @@index([storeId])
  @@index([groupId])
}

// Cópia da opção escolhida (RN-B8-07): nome do grupo, nome, preço e quantidade no momento do pedido.
model OrderItemOption {
  id          String          @id @default(cuid())
  orderItemId String
  storeId     String // API-48b
  orderItem   OrderItem       @relation(fields: [orderItemId, storeId], references: [id, storeId], onDelete: Cascade)
  groupName   String
  name        String
  priceCents  Int // preço unitário da opção (no grupo BASE, o preço-base da variação)
  quantity    Int             @default(1)
  priceMode   OptionPriceMode @default(SUM)
  optionId    String? // ESTOQUE: de qual opção veio (sem FK: a opção pode ser apagada depois); a ficha técnica da opção dá baixa

  @@index([orderItemId])
}

// ---------------------------------------------------------------------------------------------------------------------
// ESTOQUE E LUCRO (todos os planos). Insumo em UNIDADE BASE inteira (grama, mililitro ou unidade). Custo médio ponderado em
// MILÉSIMOS DE CENTAVO por unidade base (R$ 40,00/kg = 4 centavos/g = 4000). Toda mudança de saldo é uma StockMovement
// imutável; o saldo do insumo é o cache delas (conferido pelo teste). A venda grava o custo DO MOMENTO: subir o preço da
// carne não muda o lucro de um mês já fechado.
enum StockUnit {
  G
  ML
  UN
}

enum StockMovementType {
  PURCHASE      // compra/entrada, com custo (recalcula o custo médio)
  SALE          // baixa automática ao ACEITAR o pedido (ficha técnica)
  SALE_REVERSAL // estorno da baixa quando o pedido aceito é cancelado
  WASTE         // desperdício no preparo (queimou, caiu, erro)
  SPOILAGE      // estragou/venceu
  ADJUSTMENT    // ajuste de contagem (só o dono)
}

model Ingredient {
  id                 String    @id @default(cuid())
  storeId            String
  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name               String
  unit               StockUnit
  stockQty           Int       @default(0) // saldo em unidade base; pode ficar NEGATIVO (só alerta)
  minStockQty        Int? // abaixo disto, alerta de estoque baixo
  unitCostMillicents Int       @default(0) // custo médio ponderado por unidade base, em milésimos de centavo
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  recipeItems       RecipeItem[]
  optionRecipeItems OptionRecipeItem[]
  movements         StockMovement[]

  @@unique([storeId, name])
  @@unique([id, storeId])
  @@index([storeId])
}

// Ficha técnica do produto: quanto de cada insumo UMA unidade vendida consome. Produto por peso (KG/HG): quantidade por 1 kg vendido.
model RecipeItem {
  id           String     @id @default(cuid())
  storeId      String
  productId    String
  product      Product    @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId, storeId], references: [id, storeId], onDelete: NoAction)
  quantity     Int // unidade base do insumo

  @@unique([productId, ingredientId])
  @@index([storeId])
}

// Ficha técnica da opção (ex.: "bacon extra" consome 30 g de bacon), multiplicada pela quantidade escolhida.
model OptionRecipeItem {
  id           String     @id @default(cuid())
  storeId      String
  optionId     String
  option       Option     @relation(fields: [optionId, storeId], references: [id, storeId], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId, storeId], references: [id, storeId], onDelete: NoAction)
  quantity     Int

  @@unique([optionId, ingredientId])
  @@index([storeId])
}

model StockMovement {
  id                 String            @id @default(cuid())
  storeId            String
  ingredientId       String
  store              Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ingredient         Ingredient        @relation(fields: [ingredientId, storeId], references: [id, storeId], onDelete: NoAction) // histórico nunca some: insumo só se desativa (apagar insumo com movimentação é recusado pelo banco)
  type               StockMovementType
  quantity           Int // COM SINAL, unidade base (entrada > 0, saída < 0)
  unitCostMillicents Int // custo unitário aplicado (compra: o pago; saída: o médio do momento)
  costCents          Int // valor da movimentação COM SINAL, centavos (arredondado)
  orderId            String? // SALE / SALE_REVERSAL
  reason             String? // WASTE/SPOILAGE/ADJUSTMENT: motivo em lista fechada (sem texto livre)
  userId             String? // quem lançou (null = sistema)
  note               String? // observação da perda (obrigatória no motivo OUTRO)
  groupId            String? // perda de prato pronto: as linhas de um mesmo lançamento (desfazer desfaz todas)
  reversalOfId       String?           @unique // "desfazer": esta linha anula a movimentação indicada (uma vez só)
  expiresOn          DateTime?         @db.Date // compra: validade do lote
  createdAt          DateTime          @default(now())

  @@index([storeId, createdAt])
  @@index([groupId])
  @@index([storeId, type, createdAt])
  @@index([ingredientId, createdAt])
  @@index([orderId])
}

// Pedidos de "refaça a vitrine desta loja" para o web (API-58, ADR-0013 §2.4). Uma linha pendente por slug: várias
// mudanças seguidas viram uma só chamada. O job `menu.revalidate` envia e reenvia com recuo; o TTL do ISR cobre o intervalo.
model MenuRevalidation {
  slug          String   @id
  storeId       String
  requestedAt   DateTime @default(now()) // muda a cada novo pedido; evita apagar um pedido mais novo que chegou durante o envio
  nextAttemptAt DateTime @default(now())
  attempts      Int      @default(0)

  @@index([nextAttemptAt])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  storeId   String // API-48b
  order     Order       @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  status    OrderStatus
  createdAt DateTime    @default(now())
  userId          String? // quem fez (painel); null = cliente/sistema
  source          HistorySource @default(SYSTEM)
  kind            HistoryKind   @default(ADVANCE)
  reasonCode      String?
  reasonText      String?
  customerMessage String?
  seq             Int           @default(autoincrement()) // ordem total das mudanças (createdAt pode empatar no mesmo ms)

  @@index([orderId, seq])
  @@index([status, createdAt]) // kanban: encerrados de hoje sem varrer o histórico inteiro (API-71)
}

model CashSession {
  id                 String    @id @default(cuid())
  storeId            String
  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  openedByUserId     String
  openingBalanceCents Int      @default(0)
  closingBalanceCents Int?
  openedAt           DateTime @default(now())
  closedAt           DateTime?
  openingNotes       String?
  closingNotes       String?
  closedByUserId     String?
  expectedClosingCents BigInt? // saldo esperado calculado no momento do fechamento
  differenceCents    BigInt? // closingBalanceCents - expectedClosingCents
  closeReason        String? // código do motivo da diferença (lista fechada; obrigatório só acima da tolerância)
  closeReasonText    String? // texto livre SÓ quando o código é OUTRO (1 a 200); nunca vai para a auditoria
  closedByRole       String? // papel de quem fechou (OWNER/STAFF); nunca o e-mail
  summarySnapshot    Json? // retrato CONGELADO do resumo no instante do fechamento (RN-CX-15)
  cashRuleVersion    Int       @default(2) // 1 = caixa aberto antes da regra do dinheiro RECEBIDO (API-21); 2 = regra atual

  movements CashMovement[]

  @@unique([id, storeId]) // API-48b: alvo da FK composta de CashMovement
  @@index([storeId, closedAt])
}

model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  storeId       String // API-48b
  cashSession   CashSession      @relation(fields: [cashSessionId, storeId], references: [id, storeId], onDelete: Cascade)
  type          CashMovementType
  amountCents   Int
  notes         String?
  reason        String? // código do motivo (lista fechada por tipo; RN-CX-07)
  reasonText    String? // texto livre SÓ quando o código é OUTRO (1 a 200); nunca vai para a auditoria
  createdByUserId String? // sem FK de propósito: o registro sobrevive ao usuário; a API devolve só o PAPEL, nunca o e-mail
  createdByRole String? // OWNER/STAFF no instante do lançamento
  createdAt     DateTime         @default(now())
  idempotencyKey String? // API-27b (M3): Idempotency-Key do cliente; repetir a mesma chave no mesmo caixa devolve a mesma movimentação

  @@unique([cashSessionId, idempotencyKey])
  @@index([cashSessionId])
}

model Coupon {
  id            String              @id @default(cuid())
  storeId       String
  store         Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String
  discountType  CouponDiscountType
  discountValue Int // PERCENT: 1-100 · FIXED: centavos
  active        Boolean             @default(true)
  maxUses       Int?
  usedCount     Int                 @default(0)
  minOrderCents Int?
  expiresAt     DateTime?
  createdAt     DateTime            @default(now())

  orders Order[]

  @@unique([storeId, code])
  @@index([storeId])
  @@unique([id, storeId]) // API-48: alvo das FKs compostas por loja (ADR-0009)
}

// Pagamento online do pedido (hoje: PIX via Mercado Pago). Pedido sem Payment = pago
// presencialmente (dinheiro/cartão na entrega/balcão), fluxo igual ao de antes da Fase 3.
model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  storeId           String // API-48b
  order             Order         @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  provider          String        @default("mercadopago")
  providerPaymentId String?       @unique
  idempotencyKey    String?       @unique // gerada ANTES de chamar o provedor (cobrança sem órfã; ADR-0007 §6.2)
  status            PaymentStatus @default(PENDENTE)
  amountCents       Int
  pixQrCode         String? // payload "copia e cola"
  pixQrCodeBase64   String? // imagem do QR em base64
  expiresAt         DateTime?
  refundAttempts    Int           @default(0)
  refundLastError   String? // texto curto, sem dados sensíveis
  refundRequestedAt DateTime?
  refundContext     Json? // {reason, source, userId} para concluir o cancelamento depois do estorno
  lastRawStatus     String?
  lastCheckedAt     DateTime?
  reconcileNote     String? // estorno feito mas o pedido já estava finalizado: conciliação manual (nunca silencioso)
  refundManualAt    DateTime? // API-65: dono registrou que devolveu direto no app do Mercado Pago (o provedor NÃO foi chamado)
  refundManualCode  String? // API-65: código fechado do motivo; sem texto livre
  refundAbandonedAt DateTime? // API-61: dono encerrou o estorno SEM devolver por aqui (o dinheiro continua como recebido); nulo = em curso
  refundAbandonCode String? // API-61: código fechado do motivo (MP_RECUSA|PAGAMENTO_ANTIGO|CONTA_DESCONECTADA|ACERTADO_COM_CLIENTE|OUTRO); sem texto livre
  paymentAccountId  String? // conta do vendedor que criou a cobrança (API-07); pagamento antigo/da plataforma = null
  paymentAccount    PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([orderId, storeId]) // API-48b: 1:1 com o pedido pela FK composta
  @@index([orderId])
  @@index([providerPaymentId])
}

// PC-24: alertas dos dispositivos de impressão (cliente) e do detector do servidor. TELEMETRIA NÃO CONFIÁVEL: serve de aviso ao dono e à
// operação, nunca decide nada (não muda modo, não libera cobrança). Sem PII por construção: só código fechado, id opaco do pedido e versão.
enum DeviceAlertCode {
  NOTHING_TO_CHARGE_CONFLICT // cliente: servidor disse "nada a cobrar" mas o total não veio presente e 0 (alerta de DINHEIRO)
  NOTHING_TO_CHARGE_INVALID // cliente: `nothingToCharge` chegou com valor que não é booleano (alerta de DINHEIRO)
  EMPTY_ZERO_TICKET // cliente: tíquete sem itens e total zero impresso como "sem cobrança" (alerta de DINHEIRO)
  MODE_UNCONFIRMED // cliente: não consegue confirmar o modo de impressão da loja
  MODE_RECOVERED // cliente: voltou a confirmar (NÃO apaga alerta do detector do servidor)
  QUEUE_WITHOUT_PRINTER // SERVIDOR: loja em QUEUE com job pendente há minutos e nenhum claim (cozinha sem tíquete)
}

model DeviceAlert {
  id            String          @id @default(cuid())
  storeId       String
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tokenId       String? // impressora que avisou (nulo no detector do servidor); sem FK de propósito: o alerta sobrevive ao token
  code          DeviceAlertCode
  orderId       String? // só quando o pedido é DA LOJA do token; mostrado ao dono pelo CÓDIGO do pedido
  orderKey      String          @default("") // orderId ?? "" (chave do dedupe; índice único não aceita nulo como valor igual)
  clientVersion String?
  count         Int             @default(1)
  windowStart   DateTime // início da janela de 10 min do dedupe
  firstAt       DateTime        @default(now())
  lastAt        DateTime        @default(now())
  expiresAt     DateTime // lastAt + 30 dias (a `tech.cleanup` apaga depois)

  @@unique([storeId, code, orderKey, windowStart])
  @@index([storeId, lastAt])
  @@index([expiresAt])
}

// Log de ações sensíveis (quem fez o quê) — não é feature de produto, é rastro pra
// investigar disputa/incidente depois (ex.: "quem revogou essa chave", "quem fechou o caixa").
// Mensagem livre do lojista ao time do produto (API-52, ADR-0014 §3.4): tabela PRÓPRIA, nunca dentro do AuditLog (o texto pode ter dado pessoal).
model Feedback {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?
  message   String
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

// Lista de "não contatar" (API-52d, ADR-0014): só o HASH do telefone (HMAC com sal da plataforma), por loja. Sobrevive à anonimização do pedido.
model DoNotContact {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  phoneHash String
  reason    String // código (ex.: ANONYMIZED), nunca texto livre
  createdAt DateTime @default(now())

  @@unique([storeId, phoneHash])
}

model AuditLog {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId     String?
  action     String // ex.: "device_token.revoke", "product.delete", "cashier.close"
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt])
}

model Deliverer {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  orders Order[]

  @@index([storeId])
  @@unique([id, storeId]) // API-48: alvo das FKs compostas por loja (ADR-0009)
}

// ---- Planos e assinatura ----

model Plan {
  id         String   @id @default(cuid())
  code       String   @unique // ex.: "BASICO", "PRO"
  name       String
  priceCents Int // cobrança mensal
  features   String[] // chaves de recurso liberadas (só chaves "entregues": lib/features.ts)
  limits     Json     @default("{}") // { maxUsers, maxPrinters }; null = sem limite (ADR-0003 §2.1)
  active     Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(cuid())
  storeId          String             @unique
  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  planId           String?
  plan             Plan?              @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(TRIAL)
  trialEndsAt      DateTime
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  // Job subscription.transition: última fase OBSERVADA (TRIAL|ACTIVE|READ_ONLY|SUSPENDED) e quando mudou. Só histórico/auditoria:
  // quem decide o acesso continua sendo `phaseOf` na hora da leitura (pagar libera na hora, sem esperar o job).
  phase            String?
  phaseChangedAt   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  payments SubscriptionPayment[]
  notices  SubscriptionNotice[]
}

// "Quero ser avisado" (RN-B10-05): lojista tentou usar recurso que o plano não tem. Um registro por
// loja e recurso; só mede demanda, não promete data nem preço.
model FeatureInterest {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  feature   String
  createdAt DateTime @default(now())

  @@unique([storeId, feature])
  @@unique([id, storeId]) // ADR-0009: base das FKs compostas por loja
}

// Cobrança PIX de uma assinatura (conta Mercado Pago da plataforma).
model SubscriptionPayment {
  id                String        @id @default(cuid())
  subscriptionId    String
  subscription      Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planCode          String
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDENTE)
  amountCents       Int
  pixQrCode         String?
  pixQrCodeBase64   String?
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([subscriptionId])
}

// ---- Avisos da plataforma (widget de ajuda) ----

model Notice {
  id          String       @id @default(cuid())
  title       String
  body        String
  imageUrl    String?
  publishedAt DateTime     @default(now())
  expiresAt   DateTime?
  createdAt   DateTime     @default(now())

  reads NoticeRead[]
}

model NoticeRead {
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId   String
  readAt   DateTime @default(now())

  @@id([noticeId, userId])
}

// ---- Confirmação de segurança (MFA por e-mail) ----

model MfaChallenge {
  id         String    @id @default(cuid())
  userId     String
  purpose    String // ex.: "refund", "change_password"
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verifiedAt DateTime? // código digitado corretamente
  spentAt    DateTime? // comprovante já usado numa ação sensível (uso único)
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// SEC-19 / ST-30: sessões encerradas (logout de UM aparelho). O sid vem do JWT; a linha vale até o `exp`
// do token e depois é apagada pela limpeza técnica. "Sair de todos" continua sendo User.tokenVersion++.
model RevokedSession {
  sid       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Fila de impressão (ADR-0004). O servidor decide, o cliente obedece: claim com lease (relógio do BANCO), ack
// idempotente pelo dono, recuo por falha (availableAt). Tabela nova ⇒ FK composta (orderId, storeId) → Order(id, storeId).
// Modo de impressão da loja (ADR-0004 §8.12): LEGACY = o cliente lista pedidos com printedAt nulo; QUEUE = o cliente consome
// jobs (claim/ack). O servidor impede a impressão em dobro: só um dos dois caminhos funciona por vez.
enum PrintMode {
  LEGACY
  QUEUE
}

enum PrintKind {
  ORDER_KITCHEN // tíquete do pedido (1ª impressão)
  ORDER_REPRINT // 2ª via, com contador
  ORDER_CANCEL_NOTICE // aviso de cancelamento de pedido já impresso
  TEST // teste de impressora (ticket fictício, sem dado de loja/cliente)
}

enum PrintJobStatus {
  PENDING
  CLAIMED
  PRINTED
  FAILED
  CANCELED
  STALE // N6/RN-IMP-20: mais velho que a janela de retomada (12 h); não sai sozinho, o painel oferece "Imprimir agora"
}

model PrintJob {
  id               String         @id @default(cuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind             PrintKind
  orderId          String?
  order            Order?         @relation(fields: [orderId, storeId], references: [id, storeId], onDelete: Cascade)
  status           PrintJobStatus @default(PENDING)
  attempts         Int            @default(0)
  maxAttempts      Int            @default(3)
  resumedAt        DateTime? // "Imprimir agora" (N6): a janela de 12 h passa a contar daqui, não da criação
  availableAt      DateTime       @default(now()) // só é entregue com availableAt <= agora (recuo por falha)
  claimedAt        DateTime?
  leaseUntil       DateTime? // vence pelo relógio do banco; vencida = pode ser reclamada por outro
  claimedByTokenId String?
  printedAt        DateTime?
  ackStatus        String? // PRINTED | FAILED do último ack do dono (idempotência do ack repetido)
  lastErrorCode    String? // lista fechada (PRINTER_OFFLINE, NO_PAPER, DRIVER_ERROR, PRINTER_NOT_FOUND, OTHER)
  lastError        String? // texto do cliente, NÃO confiável: sanitizado e nunca mostrado/interpolado
  reprintNumber    Int? // contador da 2ª via (ORDER_REPRINT)
  requestedByUserId String? // quem pediu a reimpressão/teste (auditoria, D4-5)
  dedupeKey        String?        @unique // "orderId:ORDER_KITCHEN" / "orderId:ORDER_CANCEL_NOTICE": 1 job por (pedido, tipo)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([id, storeId])
  @@index([storeId, status, availableAt, createdAt])
  @@index([orderId])
}

// API-26 (RN-ONB-03): token de verificação de e-mail. Só o hash SHA-256 vai ao banco (NG-06); uso único; um ativo por usuário.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum OnboardingStepStatus {
  DONE
  SKIPPED
}

// API-26 (ONB.2): passo do checklist marcado pelo dono (feito ou pulado). Passo sem linha = pendente (ou concluído pelos dados da loja).
model OnboardingStep {
  storeId   String
  store     Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  step      String
  status    OnboardingStepStatus
  updatedAt DateTime             @updatedAt

  @@id([storeId, step])
}

// API-26 (RN-ONB-06, CA-ONB-07): evento de ativação por loja, no máximo um de cada tipo.
model ActivationEvent {
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind       String
  occurredAt DateTime

  @@id([storeId, kind])
}

// API-18 / ADR-0010: imagem processada (WebP em larguras fixas) guardada no ObjectStorage sob stores/<storeId>/.
// PENDING = em quarentena (objetos sendo gravados; nunca exposta); READY = publicada. PENDING velha é varrida.
enum ImageKind {
  PRODUCT
  LOGO
  COVER
}

enum ImageStatus {
  PENDING
  READY
}

model Image {
  id        String      @id @default(cuid())
  storeId   String
  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind      ImageKind
  keyBase   String      // stores/<storeId>/<uuid>; as variantes são <keyBase>-<largura>.webp
  widths    Int[]
  bytes     Int
  status    ImageStatus @default(PENDING)
  createdAt DateTime    @default(now())

  @@index([storeId, status, createdAt])
}

enum ReceiptKind {
  TABLE // BASICO: conta virtual da mesa (API-24)
  TAB // PRO: comanda (futuro)
}

// API-24 (ADR-0012, RN-MB-03/04): o FATO financeiro de receber a mesa. No BASICO: 1 ReceiptPayment, sem taxa de serviço, desconto nem divisão.
// Imutável depois de gravado (correção = estorno registrado, P2).
model Receipt {
  id              String      @id @default(cuid())
  storeId         String
  store           Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind            ReceiptKind @default(TABLE)
  tableId         String?
  table           Table?      @relation(fields: [tableId, storeId], references: [id, storeId], onDelete: NoAction)
  subtotalCents   Int
  serviceFeeCents Int         @default(0)
  discountCents   Int         @default(0)
  totalCents      Int
  receivedAt      DateTime    @default(now())
  receivedByUserId String
  cashSessionId   String?
  orders          Order[]
  payments        ReceiptPayment[]

  @@index([storeId, receivedAt])
  @@index([storeId, tableId])
  @@unique([id, storeId]) // API-48: alvo das FKs compostas por loja (ADR-0009)
}

model ReceiptPayment {
  id             String             @id @default(cuid())
  receiptId      String
  receipt        Receipt            @relation(fields: [receiptId, storeId], references: [id, storeId], onDelete: Cascade) // API-48
  storeId        String
  method         OrderPaymentMethod
  amountCents    Int
  changeForCents Int? // dinheiro: "troco para"; o valor que conta no caixa é amountCents (o aplicado à conta)

  @@index([receiptId])
  @@index([storeId, method])

// ---- API-25: back-office da plataforma (contas de equipe SEPARADAS dos usuários de loja) ----

}

enum PlatformRole {
  ADMIN   // tudo, inclusive conceder/ajustar créditos
  SUPPORT // lê lojas, suspende/reativa, estende trial, publica avisos; NÃO mexe em créditos
}

model PlatformAdmin {
  id           String       @id @default(cuid())
  email        String       @unique // sempre minúsculo
  passwordHash String
  role         PlatformRole @default(SUPPORT)
  tokenVersion Int          @default(0)
  disabledAt   DateTime?
  createdAt    DateTime     @default(now())

  auditLogs PlatformAuditLog[]
  credits   AiCreditLedger[]
}

// Auditoria da equipe (RN-BKO-03). Imutável: trigger recusa UPDATE/DELETE. Sem FK para Store de propósito (o rastro sobrevive à loja).
model PlatformAuditLog {
  id        String        @id @default(cuid())
  adminId   String
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Restrict)
  storeId   String?
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([storeId, createdAt])
  @@index([adminId, createdAt])
}

enum AiCreditReason {
  PURCHASE // crédito pago (pagamento recebido FORA do sistema; exige externalRef)
  GRANT    // concessão sem pagamento (compensação), sempre com motivo; nunca cortesia automática do PRO
  ADJUST   // ajuste (positivo ou negativo), sempre com motivo
  RESERVE
  CONSUME
  RELEASE
}

// Livro-razão de créditos de IA por loja (ADR-0015 §3D). IMUTÁVEL: só INSERT (trigger recusa UPDATE/DELETE); saldo = SUM(delta).
model AiCreditLedger {
  id             String         @id @default(cuid())
  storeId        String
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  delta          Int
  reason         AiCreditReason
  note           String? // motivo curto, sanitizado
  externalRef    String? // referência do pagamento recebido fora do sistema (sem dado de cartão)
  priceCents     Int? // preço cobrado, opcional (nulo = sem cobrança registrada)
  expiresAt      DateTime? // opcional; nulo = não expira (job de expiração desligado)
  jobId          String?
  idempotencyKey String
  actorAdminId   String?
  actorAdmin     PlatformAdmin? @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)
  createdAt      DateTime       @default(now())

  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
}

// PRATO 3D: uma geração de modelo 3D a partir de 1–4 fotos do prato (provedor externo, ex.: Rodin via fal.ai).
// Créditos: RESERVE na criação; RELEASE se falhar (o livro-razão AiCreditLedger guarda o jobId).
enum Dish3dStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model Dish3dJob {
  id                String       @id @default(cuid())
  storeId           String
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId         String
  product           Product      @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  status            Dish3dStatus @default(RUNNING)
  provider          String
  providerRequestId String
  credits           Int
  photoCount        Int
  attempts          Int          @default(0) // consultas de status feitas
  nextCheckAt       DateTime     @default(now())
  error             String?      // código curto (nunca texto do provedor cru)
  modelKey          String?      // chave no armazenamento (stores/<loja>/3d/<id>.glb)
  modelBytes        Int?
  createdByUserId   String
  createdAt         DateTime     @default(now())
  finishedAt        DateTime?

  @@index([status, nextCheckAt])
  @@index([storeId, productId, createdAt])
}

// API-10 (RN-A-06, ADR-0003 §2.4): aviso de assinatura JÁ enviado ao dono. A chave única (assinatura, tipo, `dueAt` = o vencimento a que o aviso se
// refere) é o que garante "cada aviso UMA vez": reiniciar o job ou rodar 2 instâncias não repete; renovar o plano muda o `dueAt` e reabre os avisos.
// Sem texto nem e-mail guardados (o e-mail sai do usuário na hora; o texto é fixo no código).
enum SubscriptionNoticeKind {
  D7
  D3
  D1
  READ_ONLY
  SUSPENDED
}

model SubscriptionNotice {
  id             String                 @id @default(cuid())
  subscriptionId String
  subscription   Subscription           @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kind           SubscriptionNoticeKind
  dueAt          DateTime // o vencimento (fim do teste ou do período) a que este aviso se refere
  sentAt         DateTime               @default(now())

  @@unique([subscriptionId, kind, dueAt])
  @@index([sentAt])
}

// Campanha principal do cardápio (CONTRATO-CAMPANHA). Uma linha por loja. `revision` é a revisão OTIMISTA: toda escrita só vale se a revisão enviada
// for a atual (UPDATE ... WHERE revision = esperada) e incrementa na mesma instrução. `publicId` é o ID estável da campanha no cardápio (não é o id da loja).
// `draft` e `published` guardam o conteúdo validado (JSON); a cópia publicada nunca muda por salvar rascunho.
model MenuCampaign {
  storeId   String   @id
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  publicId  String   @default(cuid())
  revision  Int      @default(0)
  draft     Json?
  published Json?
  updatedAt DateTime @updatedAt
}

enum ImportBatchStatus {
  PREVIEW
  CONFIRMED
  DISCARDED
}

// IMP-1: importação assistida de produtos. O rascunho (já validado e sanitizado) fica aqui até o dono confirmar; só então vira produto, pelo serviço de catálogo.
model ImportBatch {
  id          String            @id @default(cuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId      String?
  status      ImportBatchStatus @default(PREVIEW)
  contentHash String
  draft       Json
  result      Json?
  createdAt   DateTime          @default(now())
  finishedAt  DateTime?

  @@index([storeId, createdAt])
}
