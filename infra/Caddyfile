{
	email {$ACME_EMAIL}

	# INF-19 / C1 (Nightingale, Sun Tzu): o log de ERRO padrão do Caddy (`http.log.error`, que existe MESMO sem diretiva `log`) grava o
	# objeto `request` inteiro quando o upstream falha (web ou API fora do ar): URL com ?token=, token no CAMINHO (QR de mesa, link de
	# acompanhamento) e cabeçalhos custom (x-order-token, x-mfa-challenge, x-admin-token) saíam EM CLARO. Medido em 17/11 (Caddy 2.11.9):
	# só Authorization/Cookie/Set-Cookie/Proxy-Authorization saem REDACTED por padrão. Filtro SEGURO POR PADRÃO (não é lista negra): apaga
	# TODOS os cabeçalhos e deixa só o primeiro segmento do caminho, sem query. Aplica-se ao logger PADRÃO (erros do proxy e logs de
	# runtime). ATENÇÃO: um `log` de SITE tem encoder PRÓPRIO e NÃO herda este filtro: quem ligar log de acesso precisa repetir o filtro
	# lá. Provado por scripts/smoke-stack.sh (seção 11, upstream fora do ar) e, isolado, para a resposta abortada no meio
	# (`http.handlers.reverse_proxy`, 17/11). Os `delete` de resposta abaixo são DEFENSIVOS: nenhum cenário medido gravou esses campos.
	log {
		output stderr
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri regexp ^(/[^/?]*).*$ $1/REDACTED
				resp_headers delete
				headers delete
			}
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# SEC-24: o segredo de serviço e o IP do visitante repassado só existem entre o web (SSR) e a API pela rede interna.
	# Nada que venha da internet pode carregá-los: removidos aqui, antes de qualquer proxy, em TODAS as rotas. Sem isto um
	# visitante forjaria o segredo (ou o IP, escapando do rate limit). Provado por scripts/smoke-stack.sh (eco + controle).
	request_header -x-internal-service-secret
	request_header -x-visitor-ip

	# Rotas administrativas da plataforma (x-admin-token) NÃO ficam na internet pública: só pela rede
	# interna ou por túnel SSH até a API (ST-18). Para publicar um aviso, use o runbook.
	handle /api/admin/* {
		respond "not found" 404
	}

	# Caddy descarta qualquer X-Forwarded-For enviado pelo cliente e envia à API o IP real da
	# conexão (comportamento padrão do reverse_proxy sem `trusted_proxies`). É isso que permite
	# a API usar trustProxy + rate limit por IP sem que o cliente possa forjar o IP (B04).
	# NÃO adicione `trusted_proxies` aqui sem revisão de segurança. Verificado por
	# scripts/smoke-stack.sh (cabeçalho forjado não chega à API).
	handle /api/* {
		reverse_proxy api:3001
	}
	handle /auth/* {
		reverse_proxy api:3001
	}
	handle /stores/* {
		reverse_proxy api:3001
	}
	handle /ws/* {
		reverse_proxy api:3001
	}
	handle /health {
		reverse_proxy api:3001
	}
	# SEC-26 / ST-44: o cardápio público (/loja/*) faz o web chamar a API por slug; sem limite, varrer /loja/<aleatório> esgota
	# o balde de serviço da API. Limite POR IP REAL (remote_host da conexão: o X-Forwarded-For do cliente não conta). 120/min
	# cobre um restaurante inteiro atrás do mesmo Wi-Fi; quem passa disso recebe 429 com Retry-After. /health e a API não são afetados.
	handle /loja/* {
		rate_limit {
			zone loja_por_ip {
				key {remote_host}
				events 120
				window 1m
				# ST-45: IPv6 agrupado em /64 (um atacante com um /64 tem 2^64 endereços; sem isto cada um teria o seu limite).
				ipv6_prefix 64
			}
			# ST-49: o módulo varre e apaga limitadores vencidos (a cada 1 min por padrão); explícito para o runbook.
			sweep_interval 1m
		}
		reverse_proxy web:3000
	}
	handle {
		reverse_proxy web:3000
	}
}
