# STAGING (homologação) do Vitry — RUNBOOK-infra §17. Mesmo compose e mesmo deploy.sh da produção, em OUTRO servidor (VPS pequena),
# com OUTRO domínio e SEGREDOS PRÓPRIOS. Copie para infra/.env no servidor de staging, preencha e rode ./deploy.sh.
# Regra de ouro: NENHUM segredo, chave ou credencial de produção aqui, e NENHUM dado real de cliente no banco de staging.
#
# Diferenças em relação à produção:
#   - DEPLOY_ENV=staging: a cópia off-site vira opcional (dados de teste); o resto das regras do check-env.sh --prod vale igual
#   - domínio próprio (ex.: staging.vitry.com.br) e e-mail de teste
#   - PIX desligado, ou ligado com a aplicação de TESTE do Mercado Pago (credenciais TEST-...)
#   - alertas num canal separado (ex.: outro chat do Telegram), para não confundir com produção
DEPLOY_ENV=staging
APP_VERSION=

POSTGRES_PASSWORD=
JWT_SECRET=
MFA_HMAC_KEY=
API_INTERNAL_SECRET=
REVALIDATE_SECRET=
COOKIE_SECURE=true
MFA_ENFORCED=true

DOMAIN=staging.vitry.com.br
WEB_ORIGIN=https://staging.vitry.com.br
NEXT_PUBLIC_API_URL=https://staging.vitry.com.br
ACME_EMAIL=

# E-mail: chave do Resend de TESTE (ou um domínio de envio separado). O deploy --prod exige a chave.
RESEND_API_KEY=
EMAIL_FROM=Vitry Staging <staging@vitry.com.br>
TRIAL_DAYS=7

MP_OAUTH_MODE=off
CAPTCHA_MODE=off
NEXT_PUBLIC_MENU_CAMPAIGN_ENABLED=

# Backup local continua (para testar restauração); off-site opcional. Para testar o off-site, ligue com um bucket SÓ de staging.
COMPOSE_PROFILES=
BACKUP_KEEP_DAYS=3

ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
ALERT_HEARTBEAT_URL=
ALERT_NAME=vitry-STAGING
