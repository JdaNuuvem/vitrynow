# Copie para infra/.env e preencha; depois rode infra/deploy.sh (não use "compose up" direto: o
# deploy.sh valida este arquivo, aplica migrações e confere a saúde).
# Gere os segredos com:  openssl rand -base64 36   (nunca reutilize os de outro ambiente)
POSTGRES_PASSWORD=
JWT_SECRET=
# Versão/tag da imagem (ex.: o hash curto do commit). Mantém a imagem anterior para rollback.
APP_VERSION=local
# Segredos: 32+ caracteres aleatórios, DIFERENTES entre si. A API recusa subir sem eles ou com valor fraco.
# MFA_HMAC_KEY é a chave do MFA (nunca reaproveite o JWT_SECRET).
MFA_HMAC_KEY=
# Cookie de sessão Secure (padrão). Só "false" em teste local sem https.
COOKIE_SECURE=true
# Rede interna do compose e IP fixo do Caddy: a API só confia no X-Forwarded-For desse IP.
# Só mude se a sub-rede colidir com outra rede Docker do servidor (mude as três juntas).
INTERNAL_SUBNET=172.29.250.0/24
CADDY_IP=172.29.250.10
TRUST_PROXY_CIDR=172.29.250.10/32
DOMAIN=pedidos.sualoja.com.br
WEB_ORIGIN=https://pedidos.sualoja.com.br
NEXT_PUBLIC_API_URL=https://pedidos.sualoja.com.br
ACME_EMAIL=contato@sualoja.com.br
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=MeuCardapio <onboarding@resend.dev>
