# Copie para infra/.env e preencha; depois, na pasta infra/ (a validação automática do .env e o runbook entram no INF-11):
#   docker compose --env-file .env up -d --build
# O serviço "migrate" aplica as migrações antes da API subir. NÃO rode isto em produção sem aprovação do Claudio.
#
# POSTGRES_PASSWORD entra numa URL (DATABASE_URL): use SÓ [A-Za-z0-9_-]. Gere com:  openssl rand -hex 24
# ("openssl rand -base64" produz / e +, que quebram a URL e a API não conecta ao banco.)
# JWT_SECRET e MFA_HMAC_KEY: 32+ caracteres, diferentes entre si:  openssl rand -base64 48
# Nunca reutilize segredos de outro ambiente.
POSTGRES_PASSWORD=
JWT_SECRET=
# Versão/tag da imagem (ex.: o hash curto do commit). Mantém a imagem anterior para rollback.
APP_VERSION=local
# Segredos: 32+ caracteres aleatórios, DIFERENTES entre si. A API recusa subir sem eles ou com valor fraco.
# MFA_HMAC_KEY é a chave do MFA (nunca reaproveite o JWT_SECRET).
MFA_HMAC_KEY=
# Segredo de serviço entre o web (SSR) e a API (SEC-24): 32+ caracteres, DIFERENTE dos outros. Gere com:  openssl rand -hex 32
# Só em tempo de execução, nunca NEXT_PUBLIC_*. Rotação sem queda: novo em API_INTERNAL_SECRET, o antigo em
# API_INTERNAL_SECRET_PREVIOUS por um deploy, depois esvazie o PREVIOUS.
API_INTERNAL_SECRET=
API_INTERNAL_SECRET_PREVIOUS=
# Cookie de sessão Secure (padrão). Só "false" em teste local sem https.
COOKIE_SECURE=true
# Rede interna do compose e IP fixo do Caddy. A API só confia no X-Forwarded-For desse IP: o compose
# deriva TRUST_PROXY_CIDR de CADDY_IP (nunca defina TRUST_PROXY_CIDR à parte, para os dois não divergirem).
# Só mude se a sub-rede colidir com outra rede Docker do servidor (mude as duas juntas; CADDY_IP dentro da sub-rede).
INTERNAL_SUBNET=172.29.250.0/24
CADDY_IP=172.29.250.10
DOMAIN=pedidos.sualoja.com.br
WEB_ORIGIN=https://pedidos.sualoja.com.br
NEXT_PUBLIC_API_URL=https://pedidos.sualoja.com.br
ACME_EMAIL=contato@sualoja.com.br
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=MeuCardapio <onboarding@resend.dev>
